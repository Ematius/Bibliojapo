# Copiar a `.env.local` y rellenar con los valores del panel de Supabase.
# La clave publicable viaja en el bundle y es pública por diseño: lo que protege
# los datos son las políticas de RLS, no esconderla. La `secret` NUNCA va aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para el volcado del temario (`npm run seed:content`), nunca en el navegador: se
# salta todas las políticas de RLS. Sin prefijo VITE_ a propósito — con él, Vite la
# metería en el bundle y la base quedaría abierta desde cualquier navegador.
SUPABASE_SERVICE_ROLE_KEY=
